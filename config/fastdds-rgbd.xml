<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Only camera/perception select this profile. UDP discovery and remote
       peers remain available; local image delivery uses shared memory. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>explorer_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>explorer_rgbd_shm</transport_id>
      <type>SHM</type>
      <!-- More than twenty 640x480 RGB + registered-depth message pairs. -->
      <segment_size>33554432</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="explorer_rgbd" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>explorer_udp</transport_id>
        <transport_id>explorer_rgbd_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
