[Unit]
Description=Explorer control
PartOf=explorer.target
StartLimitIntervalSec=60
StartLimitBurst=3
After=explorer-mcu.service

[Service]
Type=simple
WorkingDirectory=/home/vlad/Explorer
ExecStart=/bin/bash /home/vlad/Explorer/bin/run.sh control
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group
UMask=0077

[Install]
WantedBy=explorer.target
