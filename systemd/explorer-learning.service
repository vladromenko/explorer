[Unit]
Description=Explorer learning
PartOf=explorer.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/vlad/Explorer
ExecStart=/bin/bash /home/vlad/Explorer/bin/run.sh learning
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group
UMask=0077
Nice=15
CPUWeight=10
MemoryMax=512M
OOMScoreAdjust=500

[Install]
WantedBy=explorer.target
