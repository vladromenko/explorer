[Unit]
Description=Explorer navigation
PartOf=explorer.target
StartLimitIntervalSec=0
Wants=explorer-mcu.service explorer-state.service explorer-ekf.service explorer-geometry.service explorer-slam.service explorer-control.service explorer-planning.service
After=explorer-mcu.service explorer-state.service explorer-ekf.service explorer-geometry.service explorer-slam.service explorer-control.service explorer-planning.service

[Service]
Type=simple
WorkingDirectory=/home/vlad/Explorer
ExecStart=/bin/bash /home/vlad/Explorer/bin/run.sh navigation
Restart=always
RestartSec=3
TimeoutStopSec=12
KillMode=control-group
UMask=0077

[Install]
WantedBy=explorer.target
